{
  "name": "event-production-management",
  "version": "0.1.0",
  "private": true,
  "description": "Event Production Management System — web admin, Express API, MySQL, and Android crew app.",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @epms/api dev",
    "dev:web": "pnpm --filter @epms/admin-web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @epms/api prisma:generate",
    "db:migrate": "pnpm --filter @epms/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @epms/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @epms/api prisma:seed",
    "db:studio": "pnpm --filter @epms/api prisma:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
