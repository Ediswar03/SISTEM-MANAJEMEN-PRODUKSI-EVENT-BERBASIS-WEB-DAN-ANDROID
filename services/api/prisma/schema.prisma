generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CREW
}

enum EventStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  UNUSABLE
}

enum AllocationStatus {
  PENDING
  ACTIVE
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  CANCELLED
}

enum CrewJobStatus {
  ASSIGNED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

model User {
  id            String    @id @default(uuid()) @db.Char(36)
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  fullName      String    @map("full_name") @db.VarChar(255)
  role          UserRole
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  crewProfile         CrewProfile?
  createdEvents       Event[]              @relation("EventCreatedBy")
  responsibleEvents   Event[]              @relation("EventResponsible")
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  idempotencyKeys     IdempotencyKey[]
  eventStatusChanges  EventStatusHistory[]

  @@index([role, isActive], map: "idx_users_role_active")
  @@map("users")
}

model CrewProfile {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @map("user_id") @db.Char(36)
  phone     String?  @db.VarChar(32)
  skills    String   @db.VarChar(512)
  notes     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments  CrewAssignment[]

  @@index([isActive], map: "idx_crew_profiles_active")
  @@map("crew_profiles")
}

model Event {
  id                 String      @id @default(uuid()) @db.Char(36)
  code               String      @unique @db.VarChar(32)
  name               String      @db.VarChar(255)
  clientName         String?     @map("client_name") @db.VarChar(255)
  location           String      @db.VarChar(512)
  timezone           String      @default("Asia/Jakarta") @db.VarChar(64)
  startAt            DateTime    @map("start_at") @db.DateTime(3)
  endAt              DateTime    @map("end_at") @db.DateTime(3)
  status             EventStatus @default(DRAFT)
  notes              String?     @db.Text
  createdById        String      @map("created_by_id") @db.Char(36)
  responsibleUserId  String?     @map("responsible_user_id") @db.Char(36)
  cancelledAt        DateTime?   @map("cancelled_at") @db.DateTime(3)
  archivedAt         DateTime?   @map("archived_at") @db.DateTime(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  createdBy       User                 @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  responsibleUser User?                @relation("EventResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  allocations     EquipmentAllocation[]
  assignments     CrewAssignment[]
  statusHistory   EventStatusHistory[]

  @@index([status, startAt, endAt], map: "idx_events_status_interval")
  @@index([startAt, endAt], map: "idx_events_interval")
  @@map("events")
}

model EventStatusHistory {
  id          String      @id @default(uuid()) @db.Char(36)
  eventId     String      @map("event_id") @db.Char(36)
  fromStatus  EventStatus? @map("from_status")
  toStatus    EventStatus  @map("to_status")
  changedById String      @map("changed_by_id") @db.Char(36)
  reason      String?     @db.VarChar(512)
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  changedBy User  @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt], map: "idx_event_status_history_event")
  @@map("event_status_history")
}

model EquipmentCategory {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  equipment Equipment[]

  @@map("equipment_categories")
}

model Equipment {
  id               String              @id @default(uuid()) @db.Char(36)
  categoryId       String              @map("category_id") @db.Char(36)
  code             String              @unique @db.VarChar(32)
  name             String              @db.VarChar(255)
  description      String?             @db.Text
  quantityOnHand   Int                 @map("quantity_on_hand")
  usableQuantity   Int                 @map("usable_quantity")
  condition        EquipmentCondition  @default(GOOD)
  storageLocation  String              @map("storage_location") @db.VarChar(255)
  isActive         Boolean             @default(true) @map("is_active")
  notes            String?             @db.Text
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  category    EquipmentCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  allocations EquipmentAllocation[]

  @@index([categoryId, isActive], map: "idx_equipment_category_active")
  @@map("equipment")
}

model EquipmentAllocation {
  id          String           @id @default(uuid()) @db.Char(36)
  eventId     String           @map("event_id") @db.Char(36)
  equipmentId String           @map("equipment_id") @db.Char(36)
  quantity    Int
  status      AllocationStatus @default(PENDING)
  startAt     DateTime         @map("start_at") @db.DateTime(3)
  endAt       DateTime         @map("end_at") @db.DateTime(3)
  notes       String?          @db.VarChar(512)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  cancelledAt DateTime?        @map("cancelled_at") @db.DateTime(3)

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@unique([eventId, equipmentId], map: "uq_allocation_event_equipment")
  @@index([equipmentId, status, startAt, endAt], map: "idx_allocation_equipment_interval")
  @@map("equipment_allocations")
}

model CrewAssignment {
  id            String           @id @default(uuid()) @db.Char(36)
  eventId       String           @map("event_id") @db.Char(36)
  crewProfileId String           @map("crew_profile_id") @db.Char(36)
  roleInEvent   String           @map("role_in_event") @db.VarChar(128)
  jobStatus     CrewJobStatus    @default(ASSIGNED) @map("job_status")
  status        AssignmentStatus @default(ACTIVE)
  startAt       DateTime         @map("start_at") @db.DateTime(3)
  endAt         DateTime         @map("end_at") @db.DateTime(3)
  notes         String?          @db.VarChar(512)
  createdAt     DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  cancelledAt   DateTime?        @map("cancelled_at") @db.DateTime(3)

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  crewProfile CrewProfile @relation(fields: [crewProfileId], references: [id], onDelete: Restrict)

  @@unique([eventId, crewProfileId], map: "uq_assignment_event_crew")
  @@index([crewProfileId, status, startAt, endAt], map: "idx_assignment_crew_interval")
  @@map("crew_assignments")
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Char(36)
  actorId      String?     @map("actor_id") @db.Char(36)
  action       String      @db.VarChar(64)
  entityType   String      @map("entity_type") @db.VarChar(64)
  entityId     String?     @map("entity_id") @db.Char(36)
  result       AuditResult
  reason       String?     @db.VarChar(512)
  metadataJson String?     @map("metadata_json") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt], map: "idx_audit_entity")
  @@index([actorId, createdAt], map: "idx_audit_actor")
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

model IdempotencyKey {
  id              String   @id @default(uuid()) @db.Char(36)
  userId          String   @map("user_id") @db.Char(36)
  key             String   @db.VarChar(128)
  requestHash     String   @map("request_hash") @db.VarChar(64)
  responseCode    Int      @map("response_code")
  responseBody    String   @map("response_body") @db.MediumText
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt       DateTime @map("expires_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key], map: "uq_idempotency_user_key")
  @@index([expiresAt], map: "idx_idempotency_expires")
  @@map("idempotency_keys")
}
