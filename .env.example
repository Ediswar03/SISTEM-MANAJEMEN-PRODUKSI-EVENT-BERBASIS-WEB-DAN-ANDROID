# Copy this file to `.env` in the repository root and to `services/api/.env`.
# Never commit real secrets. Values below are for local development only.

NODE_ENV=development
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# MySQL 8.4 InnoDB (Laragon). Empty password is Laragon's default root account.
# Create a dedicated non-root user before any production-like environment.
DATABASE_URL="mysql://root@127.0.0.1:3306/event_production_dev"
DATABASE_URL_TEST="mysql://root@127.0.0.1:3306/event_production_test"

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
